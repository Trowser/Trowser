{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trowser.dev/schemas/vpx/1.1.json",
  "title": "Vulnerability Proof eXchange (VPX) 1.1",
  "description": "JSON format for exchanging vulnerability hypotheses, multi-actor assessments, runtime proofs, evidence artifacts, and adjudicated verdicts. Unknown properties are allowed (conformance). Use the strict linter to warn about misspellings.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "vpxVersion",
    "documentId",
    "runs",
    "surfaces",
    "findings",
    "assessments",
    "proofs",
    "artifacts",
    "verdicts"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "vpxVersion": {
      "type": "string",
      "pattern": "^1\\.[1-9][0-9]*$",
      "description": "Format version. VPX 1.1 documents MUST use \"1.1\". Consumers MUST accept later 1.x minor versions they understand."
    },
    "documentId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "profile": {
      "type": "string",
      "enum": ["compact", "full", "summary"],
      "description": "Which profile constraints this document follows."
    },
    "target": { "$ref": "#/definitions/target" },
    "policy": { "$ref": "#/definitions/policy" },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/definitions/run" }
    },
    "surfaces": {
      "type": "array",
      "items": { "$ref": "#/definitions/surface" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "assessments": {
      "type": "array",
      "items": { "$ref": "#/definitions/assessment" }
    },
    "proofs": {
      "type": "array",
      "items": { "$ref": "#/definitions/proof" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "verdicts": {
      "type": "array",
      "items": { "$ref": "#/definitions/verdict" }
    }
  },
  "definitions": {
    "digest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "const": "vpx-fingerprint-1" },
        "value": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of the vpx-fingerprint-1 canonical string, prefixed with sha256:"
        }
      }
    },
    "idList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "minLength": 1 },
        "commit": {
          "type": "string",
          "minLength": 1,
          "description": "Immutable commit identifier. SHOULD NOT be a branch or tag name."
        },
        "environment": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/definitions/digest" },
        "buildDigest": { "$ref": "#/definitions/digest" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cvssCap": { "type": "number", "minimum": 0, "maximum": 10 },
        "proofRequiredAbove": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "deferBelowPriority": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["llm", "tool", "human", "service"]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "stage", "actor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "enum": [
            "source-analysis",
            "proof",
            "aggregation",
            "adjudication",
            "fix",
            "rerun"
          ]
        },
        "actor": { "$ref": "#/definitions/actor" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "inputArtifactIds": { "$ref": "#/definitions/idList" },
        "outputArtifactIds": { "$ref": "#/definitions/idList" },
        "configuration": {
          "type": "object",
          "additionalProperties": true,
          "description": "Reproducibility metadata. MUST NOT embed secrets, API keys, or confidential prompts."
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "route", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/definitions/param" }
        },
        "auth": { "$ref": "#/definitions/auth" },
        "discoveredFrom": {
          "type": "string",
          "enum": ["static", "runtime", "openapi", "inferred"]
        },
        "routeConfidence": {
          "type": "string",
          "enum": ["verified", "inferred", "unknown"]
        }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "in"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "in": {
          "type": "string",
          "enum": ["query", "body", "path", "header", "cookie"]
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object", "array"]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mechanism": { "type": "string", "minLength": 1 }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string", "maxLength": 2000 }
      }
    },
    "investigationHints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "codeSearchQueries": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1 }
        },
        "suggestedFiles": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "proofIdentity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mechanism": { "type": "string", "minLength": 1 }
      }
    },
    "proofHints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "payloads": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string" }
        },
        "oracle": {
          "type": "string",
          "minLength": 1,
          "description": "Recommended values: error, timing, reflection, dom-change, status-code, network-match, data-change, error-or-timing, none"
        },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "function": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["source", "sink", "propagator", "other"]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "severity", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/definitions/fingerprint" },
        "kind": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["hypothesis", "under_investigation", "deferred"]
        },
        "surfaceId": { "type": "string", "minLength": 1 },
        "surfaceIds": { "$ref": "#/definitions/idList" },
        "param": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/definitions/origin" },
        "trace": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "proofHints": { "$ref": "#/definitions/proofHints" },
        "reportedByRunIds": { "$ref": "#/definitions/idList" },
        "assessmentIds": { "$ref": "#/definitions/idList" },
        "owasp": { "type": "string", "minLength": 1 },
        "cwe": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "proofPriority": { "type": "number", "minimum": 0, "maximum": 100 },
        "investigationHints": { "$ref": "#/definitions/investigationHints" },
        "relatedFindingIds": { "$ref": "#/definitions/idList" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reference": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "maxLength": 2000 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "findingId", "runId", "phase", "conclusion", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "findingId": { "type": "string", "minLength": 1 },
        "proofId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "phase": {
          "type": "string",
          "enum": ["source-analysis", "proof-review", "adjudication"]
        },
        "conclusion": {
          "type": "string",
          "enum": ["supports", "disputes", "inconclusive"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/definitions/sourceLocation" }
        },
        "trace": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifactIds": { "$ref": "#/definitions/idList" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["verify-workflow", "chain-prove", "manual"]
        },
        "templateId": { "type": ["string", "null"], "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "surfaceId": { "type": "string", "minLength": 1 },
        "param": { "type": "string", "minLength": 1 },
        "payload": { "type": "string" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "observed": {
          "type": "boolean",
          "description": "Whether the expected harmful-effect signal was observed."
        },
        "expectedSignal": { "type": "string", "minLength": 1 },
        "actualSignal": { "type": "string", "minLength": 1 },
        "passed": {
          "type": "boolean",
          "description": "Deprecated in VPX 1.1. Use proof.outcome and oracle.observed."
        },
        "evidence": { "type": ["string", "object"] }
      }
    },
    "targetSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "deploymentId": { "type": "string", "minLength": 1 },
        "buildDigest": { "$ref": "#/definitions/digest" },
        "environment": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "format": "uri" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "not-required", "failed", "unknown"]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "findingId", "runId", "executedAt", "outcome"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "findingId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "format": "date-time" },
        "outcome": {
          "type": "string",
          "enum": [
            "exploited",
            "not-reproduced",
            "blocked",
            "error",
            "inconclusive"
          ]
        },
        "tool": { "$ref": "#/definitions/tool" },
        "workflow": { "$ref": "#/definitions/workflow" },
        "injection": { "$ref": "#/definitions/injection" },
        "identity": { "$ref": "#/definitions/proofIdentity" },
        "oracle": { "$ref": "#/definitions/oracle" },
        "targetSnapshot": { "$ref": "#/definitions/targetSnapshot" },
        "preconditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cleanup": { "$ref": "#/definitions/cleanup" },
        "artifactIds": { "$ref": "#/definitions/idList" },
        "evidenceSummary": { "type": "string", "maxLength": 2000 },
        "evidenceBundle": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated in VPX 1.1. Prefer artifacts[] referenced by artifactIds."
        },
        "elapsedMs": { "type": "integer", "minimum": 0 }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "redacted", "unknown"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Recommended: source-manifest, model-output, code-excerpt, http-transcript, browser-recording, screenshot, proof-script, workflow, tool-log, human-note"
        },
        "uri": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/definitions/digest" },
        "size": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "secret"]
        },
        "redaction": { "$ref": "#/definitions/redaction" },
        "producedByRunId": { "type": "string", "minLength": 1 }
      }
    },
    "remediationLocation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "function": { "type": "string", "minLength": 1 }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/definitions/remediationLocation" }
        },
        "fixPattern": { "type": "string", "minLength": 1 },
        "codeHint": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "rejected", "pending"]
        },
        "approvedByRunId": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "findingId", "exploitability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "findingId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "supersedesVerdictId": { "type": "string", "minLength": 1 },
        "basedOnAssessmentIds": { "$ref": "#/definitions/idList" },
        "basedOnProofIds": { "$ref": "#/definitions/idList" },
        "proofId": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated in VPX 1.1. Use basedOnProofIds."
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "exploitability": {
          "type": "string",
          "enum": [
            "confirmed",
            "not_exploitable",
            "not_reproduced",
            "inconclusive",
            "blocked",
            "deferred",
            "hypothesis"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "fix-now",
            "fix-scheduled",
            "accept-risk",
            "false-positive",
            "monitor"
          ]
        },
        "justification": { "type": "string", "minLength": 1 },
        "effectiveSeverity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "remediation": { "$ref": "#/definitions/remediation" },
        "approval": { "$ref": "#/definitions/approval" },
        "rerunToken": { "type": "string", "minLength": 1 }
      }
    }
  }
}
